# Образец секретов. Скопируйте в .env и заполните.
# .env в git не класть. В чат и логи значения не вставлять.

# Общие ключи. В inventory указывается имя переменной, не само значение.
HIDDIFY_SSH_KEY=
HIDDIFY_SSH_KEY_PATH=

# Пароль конкретной машины. Имя совпадает с auth.password_env в её карточке.
SSH_PASSWORD_VPN_FI_1=

# Пароль владельца панели Hiddify. После установки выставляется на сервере.
# В git не класть само значение.
HIDDIFY_ADMIN_PASSWORD=

# Токен Cloudflare: Zone Read + DNS Edit только на зоны из domains.yml.
# Не класть сюда Global API Key.
CLOUDFLARE_API_TOKEN=

# UUID админки панели живёт в inventory (admin_uuid), не здесь.
# Сюда — только если ключ общий и не привязан к одной панели.
# HIDDIFY_PANEL_API_KEY=
